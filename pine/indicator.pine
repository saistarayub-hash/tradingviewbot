//@version=6
indicator("EMA Crossover [Brain]", shorttitle="Brain EMACrossover", overlay=true, max_labels_count=500)

// ════════════════════════════════════════════════════════════════
//  EMA Crossover  (revision 1)
//  Generated by the Trading Brain — 2026-09-11 09:44 UTC
//  Source: hand-authored
//  Market: crypto · timeframe 15 · side both
//  Long entry: ema_cross_up {"fast": 9, "slow": 21}, rsi_cross_up {"length": 14, "level": 30}
//  Long exit: ema_cross_down {"fast": 9, "slow": 21}
//  Short entry: ema_cross_down {"fast": 9, "slow": 21}, rsi_cross_down {"length": 14, "level": 70}
//  Short exit: ema_cross_up {"fast": 9, "slow": 21}
//  Filters: rsi_below {"length": 14, "level": 50}
//  Short filters: rsi_above {"length": 14, "level": 50}
//  Stop: atr {"length": 14, "mult": 2.0}
//  Target: rr {"rr": 2.0}
//  NOTE: educational tool — not financial advice. Test before live use.
// ════════════════════════════════════════════════════════════════

// ── Inputs ─────────────────────────────────────────────────────────
maxBarsInTrade = input.int(100, 'Max bars in trade', minval=5)

// ── Indicator computations ────────────────────────────────────────
emaFast1 = ta.ema(close, 9)
emaSlow2 = ta.ema(close, 21)
rsi3 = ta.rsi(close, 14)

// ── Trade state ───────────────────────────────────────────────────
var bool  inLong     = false
var float longEntry  = na
var float longStop   = na
var float longTarget = na
var int   longBar    = na
var bool  inShort     = false
var float shortEntry  = na
var float shortStop   = na
var float shortTarget = na
var int   shortBar    = na

// ── Conditions ────────────────────────────────────────────────────
longCond  = ((ta.crossover(emaFast1, emaSlow2) and ta.crossover(rsi3, 30.0)) and rsi3 < 50.0)
longExitCond = ta.crossunder(emaFast1, emaSlow2)
longTrigger = longCond and not inLong
longExitTrigger = inLong and (longExitCond or (inLong and not na(longStop) and low <= longStop) or (inLong and not na(longTarget) and high >= longTarget))
shortCond  = ((ta.crossunder(emaFast1, emaSlow2) and ta.crossunder(rsi3, 70.0)) and rsi3 > 50.0)
shortExitCond = ta.crossover(emaFast1, emaSlow2)
shortTrigger = shortCond and not inShort
shortExitTrigger = inShort and (shortExitCond or (inShort and not na(shortStop) and high >= shortStop) or (inShort and not na(shortTarget) and low <= shortTarget))

// ── Position engine ───────────────────────────────────────────────
// flip: long signal while short → cover first, then enter long
if longTrigger and inShort
    inShort := false
    shortEntry := na
    shortBar := na
    shortStop := na
    shortTarget := na
    alert('{"strategy":"EMA Crossover","revision":1,"action":"BUYTOCOVER","side":"short","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}', alert.freq_once_per_bar_close)

// flip: short signal while long → sell first, then enter short
if shortTrigger and inLong
    inLong := false
    longEntry := na
    longBar := na
    longStop := na
    longTarget := na
    alert('{"strategy":"EMA Crossover","revision":1,"action":"SELL","side":"long","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}', alert.freq_once_per_bar_close)

if longTrigger
    inLong := true
    longEntry := close
    longBar := bar_index
    longStop := close - ta.atr(14) * 2.0
    longTarget := longEntry + (longEntry - longStop) * 2.0
    alert('{"strategy":"EMA Crossover","revision":1,"action":"BUY","side":"long","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}', alert.freq_once_per_bar_close)

if longExitTrigger
    inLong := false
    longEntry := na
    longBar := na
    longStop := na
    longTarget := na
    alert('{"strategy":"EMA Crossover","revision":1,"action":"SELL","side":"long","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}', alert.freq_once_per_bar_close)

if shortTrigger
    inShort := true
    shortEntry := close
    shortBar := bar_index
    shortStop := close + ta.atr(14) * 2.0
    shortTarget := shortEntry - (shortStop - shortEntry) * 2.0
    alert('{"strategy":"EMA Crossover","revision":1,"action":"SELLSHORT","side":"short","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}', alert.freq_once_per_bar_close)

if shortExitTrigger
    inShort := false
    shortEntry := na
    shortBar := na
    shortStop := na
    shortTarget := na
    alert('{"strategy":"EMA Crossover","revision":1,"action":"BUYTOCOVER","side":"short","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}', alert.freq_once_per_bar_close)

// ── Visuals ───────────────────────────────────────────────────────
plotshape(longTrigger, 'BUY', style=shape.triangleup, location=location.belowbar, color=color.new(#26a69a, 0), size=size.small)
plotshape(longExitTrigger, 'SELL', style=shape.triangledown, location=location.abovebar, color=color.new(#ef5350, 0), size=size.small)
plotshape(shortTrigger, 'SHORT', style=shape.triangledown, location=location.abovebar, color=color.new(#ff7043, 0), size=size.small)
plotshape(shortExitTrigger, 'COVER', style=shape.triangleup, location=location.belowbar, color=color.new(#42a5f5, 0), size=size.small)
bgcolor(inLong ? color.new(#26a69a, 92) : inShort ? color.new(#ef5350, 92) : na)
plot(inLong ? longStop : na, 'Long stop', style=plot.style_linebr, color=color.new(#ef5350, 20), linewidth=2)
plot(inLong ? longTarget : na, 'Long target', style=plot.style_linebr, color=color.new(#26a69a, 20), linewidth=2)
plot(inShort ? shortStop : na, 'Short stop', style=plot.style_linebr, color=color.new(#ff7043, 20), linewidth=2)
plot(inShort ? shortTarget : na, 'Short target', style=plot.style_linebr, color=color.new(#42a5f5, 20), linewidth=2)

// ── Indicator lines ───────────────────────────────────────────────
plot(emaFast1, 'EMA 9', color=color.new(#26a69a, 0), linewidth=1)
plot(emaSlow2, 'EMA 21', color=color.new(#ff9800, 0), linewidth=1)

// ── Alerts → brain webhook ────────────────────────────────────────
alertcondition(longCond, "Brain BUY — EMA Crossover", message='{"strategy":"EMA Crossover","revision":1,"action":"BUY","side":"long","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}')
alertcondition(longExitCond, "Brain SELL — EMA Crossover", message='{"strategy":"EMA Crossover","revision":1,"action":"SELL","side":"long","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}')
alertcondition(shortCond, "Brain SHORT — EMA Crossover", message='{"strategy":"EMA Crossover","revision":1,"action":"SELLSHORT","side":"short","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}')
alertcondition(shortExitCond, "Brain COVER — EMA Crossover", message='{"strategy":"EMA Crossover","revision":1,"action":"BUYTOCOVER","side":"short","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}')
