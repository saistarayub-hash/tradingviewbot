//@version=6
indicator("EMA Crossover [Brain]", shorttitle="Brain EMACrossover", overlay=true, max_labels_count=500)

// ════════════════════════════════════════════════════════════════
//  EMA Crossover  (revision 1)
//  Generated by the Trading Brain — 2026-09-11 06:12 UTC
//  Source: hand-authored
//  Market: crypto · timeframe 15 · side long
//  Entry: ema_cross_up {"fast": 9, "slow": 21}, rsi_cross_up {"length": 14, "level": 30}
//  Exit: ema_cross_down {"fast": 9, "slow": 21}
//  Filters: rsi_below {"length": 14, "level": 50}
//  Stop: atr {"length": 14, "mult": 2.0}
//  Target: rr {"rr": 2.0}
//  NOTE: educational tool — not financial advice. Test before live use.
// ════════════════════════════════════════════════════════════════

// ── Inputs ─────────────────────────────────────────────────────────
maxBarsInTrade = input.int(100, 'Max bars in trade', minval=5)

// ── Indicator computations ────────────────────────────────────────
emaFast1 = ta.ema(close, 9)
emaSlow2 = ta.ema(close, 21)
rsi3 = ta.rsi(close, 14)

// ── Trade state ───────────────────────────────────────────────────
var bool  inLong     = false
var float entryPrice = na
var float stopLevel  = na
var float targetLevel = na
var int   entryBar   = na

// ── Conditions ────────────────────────────────────────────────────
longCond  = ((ta.crossover(emaFast1, emaSlow2) and ta.crossover(rsi3, 30.0)) and rsi3 < 50.0)
exitCond  = ta.crossunder(emaFast1, emaSlow2)
longTrigger = longCond and not inLong
exitTrigger = inLong and (exitCond or (inLong and not na(stopLevel) and low <= stopLevel) or (inLong and not na(targetLevel) and high >= targetLevel))

// ── Position engine ───────────────────────────────────────────────
if longTrigger
    inLong := true
    entryPrice := close
    entryBar := bar_index
    stopLevel := close - ta.atr(14) * 2.0
    targetLevel := entryPrice + (entryPrice - stopLevel) * 2.0
    alert('{"strategy":"EMA Crossover","revision":1,"action":"BUY","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}', alert.freq_once_per_bar_close)

if exitTrigger
    inLong := false
    entryPrice := na
    entryBar := na
    stopLevel := na
    targetLevel := na
    alert('{"strategy":"EMA Crossover","revision":1,"action":"SELL","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}', alert.freq_once_per_bar_close)

// ── Visuals ───────────────────────────────────────────────────────
plotshape(longTrigger, 'BUY', style=shape.triangleup, location=location.belowbar, color=color.new(#26a69a, 0), size=size.small)
plotshape(exitTrigger, 'SELL', style=shape.triangledown, location=location.abovebar, color=color.new(#ef5350, 0), size=size.small)
bgcolor(inLong ? color.new(#26a69a, 92) : na)
plot(inLong ? stopLevel : na, 'Stop', style=plot.style_linebr, color=color.new(#ef5350, 20), linewidth=2)
plot(inLong ? targetLevel : na, 'Target', style=plot.style_linebr, color=color.new(#26a69a, 20), linewidth=2)

// ── Indicator lines ───────────────────────────────────────────────
plot(emaFast1, 'EMA 9', color=color.new(#26a69a, 0), linewidth=1)
plot(emaSlow2, 'EMA 21', color=color.new(#ff9800, 0), linewidth=1)

// ── Alerts → brain webhook ────────────────────────────────────────
alertcondition(longCond, "Brain BUY — EMA Crossover", message='{"strategy":"EMA Crossover","revision":1,"action":"BUY","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}')
alertcondition(exitCond, "Brain SELL — EMA Crossover", message='{"strategy":"EMA Crossover","revision":1,"action":"SELL","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}')
