//@version=6
indicator("HalfTrend Flip [Brain]", shorttitle="Brain HF", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ════════════════════════════════════════════════════════════════
//  HalfTrend Flip  (revision 2)
//  Generated by the Trading Brain — 2026-09-11 20:29 UTC
//  Source: hand-authored
//  Market: any · timeframe 15 · side both
//  Long entry: halftrend_up {}
//  Long exit: halftrend_down {}
//  Short entry: halftrend_down {}
//  Short exit: halftrend_up {}
//  Filters: —
//  Short filters: —
//  Stop: atr {"length": 100, "mult": 1.5}
//  Target: rr {"rr": 3.0}
//  NOTE: educational tool — not financial advice. Test before live use.
//  HalfTrend logic: everget — adapted from BigBeluga's HalfTrend Signal Engine (CC BY-NC-SA 4.0)
// ════════════════════════════════════════════════════════════════

// ┌─ 1 · INPUTS ─────────────────────────────────────────────────────
maxBarsInTrade = input.int(100, 'Max bars in trade', minval=5)

// ┌─ 2 · INDICATOR COMPUTATIONS ─────────────────────────────────────
var int htTrend1 = 0
var int htNext1 = 0
var float htMaxLow1 = low
var float htMinHigh1 = high
var float htUp1 = 0.0
var float htDown1 = 0.0

// — HalfTrend engine (amplitude 20, channel deviation 2.0)
htAtr1 = ta.atr(100) / 2
htDev1 = 2.0 * htAtr1
htHi1 = high[math.abs(ta.highestbars(high, 20))]
htLo1 = low[math.abs(ta.lowestbars(low, 20))]
htHiMa1 = ta.sma(high, 20)
htLoMa1 = ta.sma(low, 20)
htBandHi1 = 0.0
htBandLo1 = 0.0
if htNext1 == 1
    htMaxLow1 := math.max(htLo1, htMaxLow1)
    if htHiMa1 < htMaxLow1 and close < nz(low[1], low)
        htTrend1 := 1
        htNext1 := 0
        htMinHigh1 := htHi1
else
    htMinHigh1 := math.min(htHi1, htMinHigh1)
    if htLoMa1 > htMinHigh1 and close > nz(high[1], high)
        htTrend1 := 0
        htNext1 := 1
        htMaxLow1 := htLo1
if htTrend1 == 0
    if not na(htTrend1[1]) and htTrend1[1] != 0
        htUp1 := na(htDown1[1]) ? htDown1 : htDown1[1]
    else
        htUp1 := na(htUp1[1]) ? htMaxLow1 : math.max(htMaxLow1, htUp1[1])
    htBandHi1 := htUp1 + htDev1
    htBandLo1 := htUp1 - htDev1
else
    if not na(htTrend1[1]) and htTrend1[1] != 1
        htDown1 := na(htUp1[1]) ? htUp1 : htUp1[1]
    else
        htDown1 := na(htDown1[1]) ? htMinHigh1 : math.min(htMinHigh1, htDown1[1])
    htBandHi1 := htDown1 + htDev1
    htBandLo1 := htDown1 - htDev1
htLine1 = htTrend1 == 0 ? htUp1 : htDown1

// ┌─ 3 · TRADE STATE ────────────────────────────────────────────────
var bool  inLong     = false
var float longEntry  = na
var float longStop   = na
var float longTarget = na
var int   longBar    = na
var bool  inShort     = false
var float shortEntry  = na
var float shortStop   = na
var float shortTarget = na
var int   shortBar    = na
// auto position drawing — entry · stop · target lines + P&L marks
var line tradeEntry     = na   // entry price line
var line tradeStop      = na   // stop line
var line tradeTarget    = na   // take-profit line
var line tradeExit      = na   // final price line of a finished trade
var box  tradeRiskBox   = na   // shaded entry→stop zone
var box  tradeRewardBox = na   // shaded entry→target zone
var line tradeLiveLine  = na   // dotted entry→price line (live P&L)
var box  tradeLiveBox   = na   // shaded entry→price zone (live P&L)
var string posReason = "—"   // why the current position is open

// ┌─ 4 · LONG BLOCK ────── conditions · reasons · engine ─────────────
longCond      = htTrend1 == 0 and htTrend1[1] == 1
longExitCond  = htTrend1 == 1 and htTrend1[1] == 0
longReason    = "HalfTrend ↑ (bull flip)"   // shown on every BUY label
longExitMsg   = "HalfTrend ↓ (bear flip)"
longStopHit = inLong and not na(longStop) and low <= longStop
longTargetHit = inLong and not na(longTarget) and high >= longTarget
longMaxBars = false
longExitReason = longExitCond ? longExitMsg : longStopHit ? "Stop hit" : longTargetHit ? "Target hit" : "Max bars in trade"
longTrigger     = longCond and not inLong and barstate.isconfirmed
longExitTrigger = inLong and (longExitCond or longStopHit or longTargetHit or longMaxBars) and barstate.isconfirmed

// ┌─ 5 · SHORT BLOCK ───── conditions · reasons · engine ─────────────
shortCond      = htTrend1 == 1 and htTrend1[1] == 0
shortExitCond  = htTrend1 == 0 and htTrend1[1] == 1
shortReason    = "HalfTrend ↓ (bear flip)"   // shown on every SHORT label
shortExitMsg   = "HalfTrend ↑ (bull flip)"
shortStopHit = inShort and not na(shortStop) and high >= shortStop
shortTargetHit = inShort and not na(shortTarget) and low <= shortTarget
shortMaxBars = false
shortExitReason = shortExitCond ? shortExitMsg : shortStopHit ? "Stop hit" : shortTargetHit ? "Target hit" : "Max bars in trade"
shortTrigger     = shortCond and not inShort and barstate.isconfirmed
shortExitTrigger = inShort and (shortExitCond or shortStopHit or shortTargetHit or shortMaxBars) and barstate.isconfirmed

// ┌─ 6 · POSITION ENGINE ── entries · exits · reason labels · alerts ──
// (the position drawing takes the stop/target assigned in the entry block)
// keep the open position drawing and its live P&L zone extended each bar
if inLong or inShort
    line.set_x2(tradeEntry, bar_index)
    line.set_xy2(tradeLiveLine, bar_index, close)
    line.set_color(tradeLiveLine, inLong ? (close >= longEntry ? color.new(#26a69a, 20) : color.new(#ef5350, 20)) : (close <= shortEntry ? color.new(#26a69a, 20) : color.new(#ef5350, 20)))
    box.set_top(tradeLiveBox, inLong ? math.max(longEntry, close) : math.max(shortEntry, close))
    box.set_bottom(tradeLiveBox, inLong ? math.min(longEntry, close) : math.min(shortEntry, close))
    box.set_right(tradeLiveBox, bar_index)
    box.set_bgcolor(tradeLiveBox, inLong ? (close >= longEntry ? color.new(#26a69a, 88) : color.new(#ef5350, 88)) : (close <= shortEntry ? color.new(#26a69a, 88) : color.new(#ef5350, 88)))
    line.set_x2(tradeStop, bar_index)
    box.set_right(tradeRiskBox, bar_index)
    line.set_x2(tradeTarget, bar_index)
    box.set_right(tradeRewardBox, bar_index)

// flip: long signal while short → cover first, then enter long
if longTrigger and inShort
    // — close the drawing and auto-mark the finished short trade
    shortPnlR = na(shortStop) or na(shortEntry) ? na : (shortEntry - close) / (shortStop - shortEntry)
    shortPnlPct = na(shortEntry) ? na : (shortEntry - close) / shortEntry * 100.0
    shortPnlTxt = na(shortPnlR) ? "" : (shortPnlR >= 0 ? "+" : "") + str.tostring(shortPnlR, "#.##") + "R · " + (shortPnlPct >= 0 ? "+" : "") + str.tostring(shortPnlPct, "#.##") + "%"
    line.delete(tradeLiveLine)
    box.delete(tradeLiveBox)
    line.set_x2(tradeEntry, bar_index)
    line.set_x2(tradeStop, bar_index)
    box.delete(tradeRiskBox)
    line.set_x2(tradeTarget, bar_index)
    box.delete(tradeRewardBox)
    tradeExit := line.new(shortBar, close, bar_index, close, color=color.new(#d1d4dc, 35), width=2)
    inShort := false
    shortEntry := na
    shortBar := na
    shortStop := na
    shortTarget := na
    posReason := "—"
    label.new(bar_index, low, "▲ COVER\n" + longReason + (shortPnlTxt != "" ? "\nP&L " + shortPnlTxt : ""), style=label.style_label_up, color=#2a2e39, textcolor=not na(shortPnlR) and shortPnlR >= 0 ? color.new(#26a69a, 0) : color.new(#ef5350, 0), size=size.small, yloc=yloc.belowbar)
    alert('{"strategy":"HalfTrend Flip","revision":2,"action":"BUYTOCOVER","side":"short","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}', alert.freq_once_per_bar_close)

// flip: short signal while long → sell first, then enter short
if shortTrigger and inLong
    // — close the drawing and auto-mark the finished long trade
    longPnlR = na(longStop) or na(longEntry) ? na : (close - longEntry) / (longEntry - longStop)
    longPnlPct = na(longEntry) ? na : (close - longEntry) / longEntry * 100.0
    longPnlTxt = na(longPnlR) ? "" : (longPnlR >= 0 ? "+" : "") + str.tostring(longPnlR, "#.##") + "R · " + (longPnlPct >= 0 ? "+" : "") + str.tostring(longPnlPct, "#.##") + "%"
    line.delete(tradeLiveLine)
    box.delete(tradeLiveBox)
    line.set_x2(tradeEntry, bar_index)
    line.set_x2(tradeStop, bar_index)
    box.delete(tradeRiskBox)
    line.set_x2(tradeTarget, bar_index)
    box.delete(tradeRewardBox)
    tradeExit := line.new(longBar, close, bar_index, close, color=color.new(#d1d4dc, 35), width=2)
    inLong := false
    longEntry := na
    longBar := na
    longStop := na
    longTarget := na
    posReason := "—"
    label.new(bar_index, high, "▼ SELL\n" + shortReason + (longPnlTxt != "" ? "\nP&L " + longPnlTxt : ""), style=label.style_label_down, color=#2a2e39, textcolor=not na(longPnlR) and longPnlR >= 0 ? color.new(#26a69a, 0) : color.new(#ef5350, 0), size=size.small, yloc=yloc.abovebar)
    alert('{"strategy":"HalfTrend Flip","revision":2,"action":"SELL","side":"long","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}', alert.freq_once_per_bar_close)

// — long entry
if longTrigger
    inLong := true
    longEntry := close
    longBar := bar_index
    longStop := close - ta.atr(100) * 1.5
    longTarget := longEntry + (longEntry - longStop) * 3.0
    // — open the auto position drawing (entry · stop · target)
    tradeEntry := line.new(bar_index, close, bar_index, close, color=color.new(#2962ff, 25), width=2)
    tradeLiveLine := line.new(bar_index, close, bar_index, close, color=color.new(#2962ff, 25), style=line.style_dotted)
    tradeLiveBox := box.new(bar_index, close, bar_index, close, bgcolor=color.new(#26a69a, 88), border_width=0)
    tradeStop := line.new(bar_index, longStop, bar_index, longStop, color=color.new(#ef5350, 55), style=line.style_dashed)
    tradeRiskBox := box.new(bar_index, close, bar_index, longStop, bgcolor=color.new(#ef5350, 94), border_width=0)
    tradeTarget := line.new(bar_index, longTarget, bar_index, longTarget, color=color.new(#26a69a, 55), style=line.style_dashed)
    tradeRewardBox := box.new(bar_index, longTarget, bar_index, close, bgcolor=color.new(#26a69a, 94), border_width=0)
    posReason := longReason
    label.new(bar_index, low, "▲ BUY\n" + longReason, style=label.style_label_up, color=#2a2e39, textcolor=#26a69a, size=size.small, yloc=yloc.belowbar)
    alert('{"strategy":"HalfTrend Flip","revision":2,"action":"BUY","side":"long","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}', alert.freq_once_per_bar_close)

// — long exit
if longExitTrigger and inLong
    // — close the drawing and auto-mark the trade with its P&L
    longPnlR = na(longStop) or na(longEntry) ? na : (close - longEntry) / (longEntry - longStop)
    longPnlPct = na(longEntry) ? na : (close - longEntry) / longEntry * 100.0
    longPnlTxt = na(longPnlR) ? "" : (longPnlR >= 0 ? "+" : "") + str.tostring(longPnlR, "#.##") + "R · " + (longPnlPct >= 0 ? "+" : "") + str.tostring(longPnlPct, "#.##") + "%"
    line.delete(tradeLiveLine)
    box.delete(tradeLiveBox)
    line.set_x2(tradeEntry, bar_index)
    line.set_x2(tradeStop, bar_index)
    box.delete(tradeRiskBox)
    line.set_x2(tradeTarget, bar_index)
    box.delete(tradeRewardBox)
    tradeExit := line.new(longBar, close, bar_index, close, color=color.new(#d1d4dc, 35), width=2)
    inLong := false
    longEntry := na
    longBar := na
    longStop := na
    longTarget := na
    posReason := "—"
    label.new(bar_index, high, "▼ SELL\n" + longExitReason + (longPnlTxt != "" ? "\nP&L " + longPnlTxt : ""), style=label.style_label_down, color=#2a2e39, textcolor=not na(longPnlR) and longPnlR >= 0 ? color.new(#26a69a, 0) : color.new(#ef5350, 0), size=size.small, yloc=yloc.abovebar)
    alert('{"strategy":"HalfTrend Flip","revision":2,"action":"SELL","side":"long","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}', alert.freq_once_per_bar_close)

// — short entry
if shortTrigger
    inShort := true
    shortEntry := close
    shortBar := bar_index
    shortStop := close + ta.atr(100) * 1.5
    shortTarget := shortEntry - (shortStop - shortEntry) * 3.0
    // — open the auto position drawing (entry · stop · target)
    tradeEntry := line.new(bar_index, close, bar_index, close, color=color.new(#2962ff, 25), width=2)
    tradeLiveLine := line.new(bar_index, close, bar_index, close, color=color.new(#2962ff, 25), style=line.style_dotted)
    tradeLiveBox := box.new(bar_index, close, bar_index, close, bgcolor=color.new(#26a69a, 88), border_width=0)
    tradeStop := line.new(bar_index, shortStop, bar_index, shortStop, color=color.new(#ef5350, 55), style=line.style_dashed)
    tradeRiskBox := box.new(bar_index, shortStop, bar_index, close, bgcolor=color.new(#ef5350, 94), border_width=0)
    tradeTarget := line.new(bar_index, shortTarget, bar_index, shortTarget, color=color.new(#26a69a, 55), style=line.style_dashed)
    tradeRewardBox := box.new(bar_index, close, bar_index, shortTarget, bgcolor=color.new(#26a69a, 94), border_width=0)
    posReason := shortReason
    label.new(bar_index, high, "▼ SHORT\n" + shortReason, style=label.style_label_down, color=#2a2e39, textcolor=#ff7043, size=size.small, yloc=yloc.abovebar)
    alert('{"strategy":"HalfTrend Flip","revision":2,"action":"SELLSHORT","side":"short","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}', alert.freq_once_per_bar_close)

// — short exit (cover)
if shortExitTrigger and inShort
    // — close the drawing and auto-mark the trade with its P&L
    shortPnlR = na(shortStop) or na(shortEntry) ? na : (shortEntry - close) / (shortStop - shortEntry)
    shortPnlPct = na(shortEntry) ? na : (shortEntry - close) / shortEntry * 100.0
    shortPnlTxt = na(shortPnlR) ? "" : (shortPnlR >= 0 ? "+" : "") + str.tostring(shortPnlR, "#.##") + "R · " + (shortPnlPct >= 0 ? "+" : "") + str.tostring(shortPnlPct, "#.##") + "%"
    line.delete(tradeLiveLine)
    box.delete(tradeLiveBox)
    line.set_x2(tradeEntry, bar_index)
    line.set_x2(tradeStop, bar_index)
    box.delete(tradeRiskBox)
    line.set_x2(tradeTarget, bar_index)
    box.delete(tradeRewardBox)
    tradeExit := line.new(shortBar, close, bar_index, close, color=color.new(#d1d4dc, 35), width=2)
    inShort := false
    shortEntry := na
    shortBar := na
    shortStop := na
    shortTarget := na
    posReason := "—"
    label.new(bar_index, low, "▲ COVER\n" + shortExitReason + (shortPnlTxt != "" ? "\nP&L " + shortPnlTxt : ""), style=label.style_label_up, color=#2a2e39, textcolor=not na(shortPnlR) and shortPnlR >= 0 ? color.new(#26a69a, 0) : color.new(#ef5350, 0), size=size.small, yloc=yloc.belowbar)
    alert('{"strategy":"HalfTrend Flip","revision":2,"action":"BUYTOCOVER","side":"short","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}', alert.freq_once_per_bar_close)

// ┌─ 7 · VISUALS ─────── auto position drawing · entry / stop / target ──
// (live P&L zone while a trade runs; finished trades stay on the chart, auto-marked)

// ┌─ 8 · INDICATOR LINES ──────────────────────────────────────────────
plot(htLine1, 'HalfTrend', color=htTrend1 == 0 ? color.new(#26a69a, 0) : color.new(#ef5350, 0), linewidth=3)
plot(htBandHi1, 'HalfTrend band high', color=color.new(#ef5350, 90))
plot(htBandLo1, 'HalfTrend band low', color=color.new(#26a69a, 90))

// ┌─ 9 · POSITION PANEL ── live table (top-right) ─────────────────────
var table posTable = table.new(position.top_right, 2, 7, bgcolor=color.new(#1e222d, 90), border_width=1, border_color=color.new(#363a45, 100))
if barstate.isfirst
    table.merge_cells(posTable, 0, 0, 1, 0)
if barstate.islast
    table.cell(posTable, 0, 0, "TRADING BRAIN · HalfTrend Flip", text_color=color.new(#2962ff, 0), text_size=size.small)
    table.cell(posTable, 0, 1, "Position", text_color=color.new(#787b86, 0), text_size=size.small)
    table.cell(posTable, 1, 1, inLong ? "LONG ▲" : inShort ? "SHORT ▼" : "FLAT —", text_color=color.new(#d1d4dc, 0), text_size=size.small)
    table.cell(posTable, 0, 2, "Entry", text_color=color.new(#787b86, 0), text_size=size.small)
    table.cell(posTable, 1, 2, inLong ? str.tostring(longEntry) : inShort ? str.tostring(shortEntry) : "—", text_size=size.small)
    table.cell(posTable, 0, 3, "Stop", text_color=color.new(#787b86, 0), text_size=size.small)
    table.cell(posTable, 1, 3, inLong ? str.tostring(longStop) : inShort ? str.tostring(shortStop) : "—", text_color=color.new(#d1d4dc, 0), text_size=size.small)
    table.cell(posTable, 0, 4, "Target", text_color=color.new(#787b86, 0), text_size=size.small)
    table.cell(posTable, 1, 4, inLong ? str.tostring(longTarget) : inShort ? str.tostring(shortTarget) : "—", text_color=color.new(#d1d4dc, 0), text_size=size.small)
    table.cell(posTable, 0, 5, "P&L", text_color=color.new(#787b86, 0), text_size=size.small)
    table.cell(posTable, 1, 5, inLong ? (na(longEntry) or na(longStop) ? "—" : (close >= longEntry ? "+" : "") + str.tostring((close - longEntry) / (longEntry - longStop), "#.##") + "R") : inShort ? (na(shortEntry) or na(shortStop) ? "—" : (close <= shortEntry ? "+" : "") + str.tostring((shortEntry - close) / (shortStop - shortEntry), "#.##") + "R") : "—", text_color=inLong and not na(longEntry) ? (close >= longEntry ? color.new(#26a69a, 0) : color.new(#ef5350, 0)) : inShort and not na(shortEntry) ? (close <= shortEntry ? color.new(#26a69a, 0) : color.new(#ef5350, 0)) : color.new(#d1d4dc, 0), text_size=size.small)
    table.cell(posTable, 0, 6, "Reason", text_color=color.new(#787b86, 0), text_size=size.small)
    table.cell(posTable, 1, 6, posReason, text_size=size.small)

// ┌─ 10 · ALERTS ──────── wire these to your brain webhook ─────────────
alertcondition(longCond, "Brain BUY — HalfTrend Flip", message='{"strategy":"HalfTrend Flip","revision":2,"action":"BUY","side":"long","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}')
alertcondition(longExitCond, "Brain SELL — HalfTrend Flip", message='{"strategy":"HalfTrend Flip","revision":2,"action":"SELL","side":"long","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}')
alertcondition(shortCond, "Brain SHORT — HalfTrend Flip", message='{"strategy":"HalfTrend Flip","revision":2,"action":"SELLSHORT","side":"short","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}')
alertcondition(shortExitCond, "Brain COVER — HalfTrend Flip", message='{"strategy":"HalfTrend Flip","revision":2,"action":"BUYTOCOVER","side":"short","symbol":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{time}}"}')
