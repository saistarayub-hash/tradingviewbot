//@version=6
strategy("EMA Crossover [Brain BT]", shorttitle="Brain EMACrossover BT", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0)

// ════════════════════════════════════════════════════════════════
//  EMA Crossover  (revision 1)
//  Generated by the Trading Brain — 2026-09-11 10:10 UTC
//  Source: hand-authored
//  Market: crypto · timeframe 15 · side both
//  Long entry: ema_cross_up {"fast": 9, "slow": 21}, rsi_cross_up {"length": 14, "level": 30}
//  Long exit: ema_cross_down {"fast": 9, "slow": 21}
//  Short entry: ema_cross_down {"fast": 9, "slow": 21}, rsi_cross_down {"length": 14, "level": 70}
//  Short exit: ema_cross_up {"fast": 9, "slow": 21}
//  Filters: rsi_below {"length": 14, "level": 50}
//  Short filters: rsi_above {"length": 14, "level": 50}
//  Stop: atr {"length": 14, "mult": 2.0}
//  Target: rr {"rr": 2.0}
//  NOTE: educational tool — not financial advice. Test before live use.
// ════════════════════════════════════════════════════════════════

// ── Indicator computations ────────────────────────────────────────
emaFast1 = ta.ema(close, 9)
emaSlow2 = ta.ema(close, 21)
rsi3 = ta.rsi(close, 14)

// ── Position state (stop / target captured at entry) ─────────────
var float longEntry = na
var float longStop = na
var float longTarget = na
var float shortEntry = na
var float shortStop = na
var float shortTarget = na

// ── Conditions ────────────────────────────────────────────────────
longCond  = ((ta.crossover(emaFast1, emaSlow2) and ta.crossover(rsi3, 30.0)) and rsi3 < 50.0)
longExitCond = ta.crossunder(emaFast1, emaSlow2)
shortCond  = ((ta.crossunder(emaFast1, emaSlow2) and ta.crossunder(rsi3, 70.0)) and rsi3 > 50.0)
shortExitCond = ta.crossover(emaFast1, emaSlow2)

// ── Entries ───────────────────────────────────────────────────────
if longCond and strategy.position_size <= 0
    strategy.entry('Long', strategy.long)
    longEntry := close
    longStop := close - ta.atr(14) * 2.0
    longTarget := longEntry + (longEntry - longStop) * 2.0

if shortCond and strategy.position_size >= 0
    strategy.entry('Short', strategy.short)
    shortEntry := close
    shortStop := close + ta.atr(14) * 2.0
    shortTarget := shortEntry - (shortStop - shortEntry) * 2.0

// ── Signal exits ───────────────────────────────────────────────────
if longExitCond and strategy.position_size > 0
    strategy.close('Long', comment='Signal exit')

if shortExitCond and strategy.position_size < 0
    strategy.close('Short', comment='Signal exit')

// ── Risk management exits ─────────────────────────────────────────
if strategy.position_size > 0 and not na(longStop) and not na(longTarget)
    strategy.exit('LongRisk', from_entry='Long', stop=longStop, limit=longTarget)
if strategy.position_size < 0 and not na(shortStop) and not na(shortTarget)
    strategy.exit('ShortRisk', from_entry='Short', stop=shortStop, limit=shortTarget)

// ── Indicator lines ───────────────────────────────────────────────
plot(emaFast1, 'EMA 9', color=color.new(#26a69a, 0), linewidth=1)
plot(emaSlow2, 'EMA 21', color=color.new(#ff9800, 0), linewidth=1)
