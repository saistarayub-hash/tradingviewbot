//@version=6
strategy("HalfTrend Flip [Brain BT]", shorttitle="Brain HalfTrendFlip BT", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0)

// ════════════════════════════════════════════════════════════════
//  HalfTrend Flip  (revision 2)
//  Generated by the Trading Brain — 2026-09-11 10:25 UTC
//  Source: hand-authored
//  Market: any · timeframe 15 · side both
//  Long entry: halftrend_up {}
//  Long exit: halftrend_down {}
//  Short entry: halftrend_down {}
//  Short exit: halftrend_up {}
//  Filters: —
//  Short filters: —
//  Stop: atr {"length": 100, "mult": 1.5}
//  Target: rr {"rr": 3.0}
//  NOTE: educational tool — not financial advice. Test before live use.
//  HalfTrend logic: everget — adapted from BigBeluga's HalfTrend Signal Engine (CC BY-NC-SA 4.0)
// ════════════════════════════════════════════════════════════════

// ── Indicator computations ────────────────────────────────────────
var int htTrend1 = 0
var int htNext1 = 0
var float htMaxLow1 = low
var float htMinHigh1 = high
var float htUp1 = 0.0
var float htDown1 = 0.0

// — HalfTrend engine (amplitude 20, channel deviation 2.0)
htAtr1 = ta.atr(100) / 2
htDev1 = 2.0 * htAtr1
htHi1 = high[math.abs(ta.highestbars(high, 20))]
htLo1 = low[math.abs(ta.lowestbars(low, 20))]
htHiMa1 = ta.sma(high, 20)
htLoMa1 = ta.sma(low, 20)
htBandHi1 = 0.0
htBandLo1 = 0.0
if htNext1 == 1
    htMaxLow1 := math.max(htLo1, htMaxLow1)
    if htHiMa1 < htMaxLow1 and close < nz(low[1], low)
        htTrend1 := 1
        htNext1 := 0
        htMinHigh1 := htHi1
else
    htMinHigh1 := math.min(htHi1, htMinHigh1)
    if htLoMa1 > htMinHigh1 and close > nz(high[1], high)
        htTrend1 := 0
        htNext1 := 1
        htMaxLow1 := htLo1
if htTrend1 == 0
    if not na(htTrend1[1]) and htTrend1[1] != 0
        htUp1 := na(htDown1[1]) ? htDown1 : htDown1[1]
    else
        htUp1 := na(htUp1[1]) ? htMaxLow1 : math.max(htMaxLow1, htUp1[1])
    htBandHi1 := htUp1 + htDev1
    htBandLo1 := htUp1 - htDev1
else
    if not na(htTrend1[1]) and htTrend1[1] != 1
        htDown1 := na(htUp1[1]) ? htUp1 : htUp1[1]
    else
        htDown1 := na(htDown1[1]) ? htMinHigh1 : math.min(htMinHigh1, htDown1[1])
    htBandHi1 := htDown1 + htDev1
    htBandLo1 := htDown1 - htDev1
htLine1 = htTrend1 == 0 ? htUp1 : htDown1

// ── Position state (stop / target captured at entry) ─────────────
var float longEntry = na
var float longStop = na
var float longTarget = na
var float shortEntry = na
var float shortStop = na
var float shortTarget = na

// ── Conditions ────────────────────────────────────────────────────
longCond  = htTrend1 == 0 and htTrend1[1] == 1
longExitCond = htTrend1 == 1 and htTrend1[1] == 0
shortCond  = htTrend1 == 1 and htTrend1[1] == 0
shortExitCond = htTrend1 == 0 and htTrend1[1] == 1

// ── Entries ───────────────────────────────────────────────────────
if longCond and strategy.position_size <= 0
    strategy.entry('Long', strategy.long)
    longEntry := close
    longStop := close - ta.atr(100) * 1.5
    longTarget := longEntry + (longEntry - longStop) * 3.0

if shortCond and strategy.position_size >= 0
    strategy.entry('Short', strategy.short)
    shortEntry := close
    shortStop := close + ta.atr(100) * 1.5
    shortTarget := shortEntry - (shortStop - shortEntry) * 3.0

// ── Signal exits ───────────────────────────────────────────────────
if longExitCond and strategy.position_size > 0
    strategy.close('Long', comment='Signal exit')

if shortExitCond and strategy.position_size < 0
    strategy.close('Short', comment='Signal exit')

// ── Risk management exits ─────────────────────────────────────────
if strategy.position_size > 0 and not na(longStop) and not na(longTarget)
    strategy.exit('LongRisk', from_entry='Long', stop=longStop, limit=longTarget)
if strategy.position_size < 0 and not na(shortStop) and not na(shortTarget)
    strategy.exit('ShortRisk', from_entry='Short', stop=shortStop, limit=shortTarget)

// ── Indicator lines ───────────────────────────────────────────────
plot(htLine1, 'HalfTrend', color=htTrend1 == 0 ? color.new(#26a69a, 0) : color.new(#ef5350, 0), linewidth=3)
plot(htBandHi1, 'HalfTrend band high', color=color.new(#ef5350, 78))
plot(htBandLo1, 'HalfTrend band low', color=color.new(#26a69a, 78))
